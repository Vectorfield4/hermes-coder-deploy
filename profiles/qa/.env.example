# GitHub
GITHUB_TOKEN=your_github_pat_here

# FTP
FTP_HOST=your_ftp_host_here
FTP_USER=your_ftp_username_here
FTP_PASS=your_ftp_password_here

# Vercel (staging deploy after PR merge)
# VERCEL_TOKEN is required and shared by all projects.
# VERCEL_ORG_ID / VERCEL_PROJECT_ID are optional legacy fallbacks — prefer a committed
# .vercel/project.json per project (see README -> Deployment -> Vercel staging).
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_vercel_org_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# AI (DeepSeek)
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_API_BASE=https://api.deepseek.com/v1

# Dense-Mem (RAG memory layer)
# Profile API key created via scripts/memory-bootstrap.sh (control portal).
DENSE_MEM_API_KEY=your_dense_mem_profile_api_key_here