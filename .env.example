# ===========================================================================
# Dense-Mem memory stack (root .env)
# ===========================================================================
# Copied from .env.example to .env by `make init`. Used by docker-compose for
# the memory-db / embedding / dense-mem services via variable interpolation.
# Worker profiles additionally need their own DENSE_MEM_API_KEY (see below).

# --- PostgreSQL (durable memory store) ---
POSTGRES_USER=densemem
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=densemem

# --- Control portal (creates teams / profiles / API keys) ---
# Used by scripts/memory-bootstrap.sh and the admin portal at :8090.
CONTROL_PORTAL_TOKEN=change_me_strong_token

# --- Embedding provider (local TEI, all-MiniLM-L6-v2) ---
# AI_API_KEY must be non-empty; the TEI embedding service ignores its value.
# If you swap the embedding model, keep AI_API_EMBEDDING_DIMENSIONS in sync
# (dense-mem rejects model/dimension mismatches at startup).
AI_API_KEY=tei
AI_API_EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_API_EMBEDDING_DIMENSIONS=384

# --- Verifier provider (OpenAI-compatible chat endpoint, e.g. DeepSeek) ---
# dense-mem uses this to validate facts before promoting them to active memory.
AI_VERIFIER_API_URL=https://api.deepseek.com/v1
AI_VERIFIER_API_KEY=your_deepseek_api_key_here
AI_VERIFIER_MODEL=deepseek-chat

# --- Per-worker Dense-Mem API keys ---
# Not set here. Create them with:  bash scripts/memory-bootstrap.sh
# then paste each profile key into profiles/<p>/.env as DENSE_MEM_API_KEY.
